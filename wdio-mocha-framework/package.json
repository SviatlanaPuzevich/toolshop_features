{
  "name": "wdio-mocha-framework",
  "type": "module",
  "scripts": {
    "test": "wdio run ./wdio.conf.ts",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure": "allure serve allure-results",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.3",
    "@wdio/allure-reporter": "^9.30.0",
    "@wdio/cli": "^9.29.0",
    "@wdio/globals": "^9.28.0",
    "@wdio/local-runner": "^9.28.0",
    "@wdio/mocha-framework": "^9.28.0",
    "@wdio/spec-reporter": "^9.29.1",
    "allure-commandline": "^2.43.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-wdio": "^9.29.1",
    "expect-webdriverio": "^5.6.8",
    "prettier": "^3.8.4",
    "typescript-eslint": "^8.61.1"
  },
  "dependencies": {
    "chai": "^6.2.2"
  }
}
